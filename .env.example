# Next Respack 环境配置示例
# 首次部署时复制为 .env：cp .env.example .env
# Web 安装向导会自动改写此文件；请勿把真实的 .env 提交到版本库。
# 若 .env 中留空 APP_KEY，安装向导会生成临时密钥并写入正式密钥。

APP_NAME="Next Respack"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_INSTALLED=false
APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# 安装向导会在安装时写入真实的数据库连接信息。
# 支持 mysql / mariadb / sqlite。
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=next_respack
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# 共享主机推荐使用 file，避免依赖 Redis / 数据库会话表。
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
CACHE_PREFIX=nextrespack

# 邮件默认写入日志；安装完成后可在后台“设置”中配置 SMTP。
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# 可选：自定义本地资源包存储目录（默认 storage/app/private/resource-packs）。
# 必须位于 public 文档根目录之外。
# NEXT_RESPACK_STORAGE_ROOT=

VITE_APP_NAME="${APP_NAME}"
